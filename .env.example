# Gemini API key. Server-only — never exposed to the browser. Without it the
# proposal generator must show a visible "unavailable" state, never a template.
GEMINI_API_KEY=

# Gemini model id. Verified against the installed @google/genai (2.24.0) Model
# type union at node_modules/@google/genai/dist/node/node.d.ts. Kept
# configurable since Gemini model ids rotate; check that file if generation
# starts failing with an unknown-model error.
GEMINI_MODEL=gemini-3.8-flash

# Local single-owner identity recorded as the approver on review decisions.
OWNER_NAME=

# Directory for the local JSON file persistence adapter. Git-ignored. Only
# used when SUPABASE_URL/SUPABASE_PUBLISHABLE_KEY are absent, and only
# outside a production runtime — see src/server/repository-backend.ts.
DATA_DIR=.data

# --- Supabase (production persistence + owner auth) ---------------------
# See odd/tasks/supabase-production-persistence.md for the full migration
# and the owner bootstrap checklist.

# Supabase project URL (e.g. https://xbduwatnllbwpvcyxkha.supabase.co).
# Safe to expose to the browser, but only ever read on the server in this
# app (src/shared/infrastructure/supabase/server.ts and proxy.ts).
SUPABASE_URL=

# Supabase publishable (anon) key — never the secret/service-role key. Every
# query still goes through Row Level Security scoped to the authenticated
# owner (supabase/migrations/20260925053019_workspace_schema.sql).
SUPABASE_PUBLISHABLE_KEY=

# The Supabase Auth user id (UUID) of the single allow-listed owner. Server
# -only allow-list checked against the verified JWT `sub` claim
# (src/shared/infrastructure/supabase/owner-policy.ts) — authorization fails
# closed if this is missing or does not match. Never the owner's email or
# password.
SUPABASE_OWNER_ID=

# --- .data -> Supabase importer (scripts/import-data.ts) -----------------
# Only needed to run `npm run import:data`. The importer signs in as the
# owner via supabase.auth.signInWithPassword() against
# SUPABASE_PUBLISHABLE_KEY above — the same auth path the app itself uses,
# never a service-role/secret key. Server-only; never committed.
IMPORT_OWNER_EMAIL=
IMPORT_OWNER_PASSWORD=
